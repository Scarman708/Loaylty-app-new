{% comment %}
  Loyalty Widget (Theme App Block)
  Loads CSS/JS from /assets via schema (no inline tags allowed in app blocks).
{% endcomment %}

{% schema %}
{
  "name": "Loyalty widget",
  "target": "section",
  "stylesheet": "assets/loyalty-widget.css",
  "javascript": "assets/loyalty-widget.js",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Earn rewards" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Sign in to collect points on every purchase." },
    {
      "type": "select", "id": "variant", "label": "Style", "default": "card",
      "options": [
        { "value": "inline", "label": "Inline" },
        { "value": "badge", "label": "Badge" },
        { "value": "card", "label": "Card" }
      ]
    },
    { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "default": 14, "min": 0, "max": 30, "step": 1, "unit": "px" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f6f7f9" },
    { "type": "color", "id": "fg", "label": "Text color", "default": "#111111" },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ]
}
{% endschema %}

{%- assign s = block.settings -%}
<div
  class="loyalty-widget loyalty-widget--{{ s.variant }}"
  id="loyalty-widget-{{ block.id }}"
  data-block-id="{{ block.id }}"
  data-variant="{{ s.variant }}"
  data-shopify-locale="{{ request.locale.iso_code }}"
  data-customer-id="{{ customer.id | default: '' }}"
  style="
    --lw-bg: {{ s.bg }};
    --lw-fg: {{ s.fg }};
    --lw-radius: {{ s.corner_radius | default: 14 }}px;
    --lw-align: {{ s.align }};
  "
>
  <div class="loyalty-widget__content">
    <div class="loyalty-widget__row">
      {% if s.show_icon %}
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5
            2 6 4 4 6.5 4c1.74 0 3.41.81 4.5 2.09C12.09 4.81 13.76 4 15.5 4
            18 4 20 6 20 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      {% endif %}
      <h3 class="loyalty-widget__heading">{{ s.heading | escape }}</h3>
    </div>
    {% if s.subtext != blank %}
      <p class="loyalty-widget__subtext">{{ s.subtext | newline_to_br }}</p>
    {% endif %}
  </div>

  <div id="loyalty-mount-{{ block.id }}"></div>
</div>
