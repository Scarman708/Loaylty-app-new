{% comment %}
  Checkout Goal (Theme App Block)
  - Place on the cart template (or any section exposing the `cart` object).
  - Two goal modes:
      1) Subtotal goal (e.g., "Reach $100 to unlock a perk")
      2) Points goal (e.g., "Reach 500 points this order")
  - Reuses: assets/loyalty-widget.css & assets/loyalty-widget.js
  - Server-side calc; we can add live updates later by extending your JS (single-file change).
{% endcomment %}

{% schema %}
{
  "name": "Checkout goal",
  "target": "section",
  "stylesheet": "assets/loyalty-widget.css",
  "javascript": "assets/loyalty-widget.js",
  "settings": [
    {
      "type": "select",
      "id": "goal_type",
      "label": "Goal type",
      "default": "subtotal",
      "options": [
        { "value": "subtotal", "label": "Subtotal amount" },
        { "value": "points", "label": "Points this order" }
      ]
    },

    { "type": "text", "id": "heading", "label": "Heading", "default": "Checkout goal" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Add more items to reach your goal and maximize rewards." },

    /* Subtotal goal settings (major currency units, e.g. 100 = $100) */
    { "type": "number", "id": "goal_subtotal_major", "label": "Subtotal goal ({{ shop.currency }})", "default": 100 },

    /* Points goal settings */
    { "type": "range", "id": "points_per_unit", "label": "Points per 1 {{ shop.currency }}", "default": 10, "min": 1, "max": 100, "step": 1 },
    { "type": "number", "id": "goal_points", "label": "Points goal", "default": 500 },

    /* Visuals */
    { "type": "checkbox", "id": "show_icon", "label": "Show icon", "default": true },
    { "type": "checkbox", "id": "show_progress", "label": "Show progress bar", "default": true },
    { "type": "color", "id": "bg", "label": "Background", "default": "#f6f7f9" },
    { "type": "color", "id": "fg", "label": "Text color", "default": "#111111" },
    { "type": "color", "id": "bar_bg", "label": "Progress track", "default": "#e8e9ec" },
    { "type": "color", "id": "bar_fg", "label": "Progress fill", "default": "#111111" },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "default": 14, "min": 0, "max": 30, "step": 1, "unit": "px" },
    {
      "type": "select", "id": "align", "label": "Alignment", "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    }
  ]
}
{% endschema %}

{%- assign s = block.settings -%}
{%- assign rate = s.points_per_unit | default: 10 -%}

/* cart total (cents) */
{%- if cart and cart.item_count > 0 -%}
  {%- assign cart_cents = cart.total_price -%}
{%- else -%}
  {%- assign cart_cents = 0 -%}
{%- endif -%}

{%- assign cart_major = cart_cents | divided_by: 100.0 -%}

/* points earned this order (rounded to nearest by default) */
{%- assign raw_points = cart_major | times: rate -%}
{%- assign order_points = raw_points | round -%}

/* figure out the goal + remaining */
{%- assign mode = s.goal_type | default: 'subtotal' -%}
{%- assign reached = false -%}
{%- assign remaining_cents = 0 -%}
{%- assign goal_label = '' -%}

{%- if mode == 'points' -%}
  {%- assign goal_points = s.goal_points | default: 500 -%}
  {%- assign remaining_points = goal_points | minus: order_points -%}
  {%- if remaining_points <= 0 -%}
    {%- assign reached = true -%}
  {%- else -%}
    {%- comment -%}
      convert needed points to extra subtotal (in cents)
      needed_cents = ceil( remaining_points * 100 / rate )
    {%- endcomment -%}
    {%- assign needed_times_100 = remaining_points | times: 100.0 -%}
    {%- assign needed_major = needed_times_100 | divided_by: rate -%}
    {%- assign remaining_cents = needed_major | ceil -%}
  {%- endif -%}
  {%- assign goal_label = goal_points | append: ' points' -%}
{%- else -%}
  {%- comment -%} goal subtotal in major currency -> cents {%- endcomment -%}
  {%- assign goal_major = s.goal_subtotal_major | default: 100 | plus: 0.0 -%}
  {%- assign goal_cents = goal_major | times: 100 | round -%}
  {%- assign remaining_cents = goal_cents | minus: cart_cents -%}
  {%- if remaining_cents <= 0 -%}
    {%- assign reached = true -%}
    {%- assign remaining_cents = 0 -%}
  {%- endif -%}
  {%- assign goal_label = goal_major | money -%}
{%- endif -%}

/* progress percent (0-100) */
{%- assign percent = 0 -%}
{%- if mode == 'points' -%}
  {%- assign denom = goal_points | default: 1 -%}
  {%- assign num = order_points | times: 100 -%}
  {%- assign percent = num | divided_by: denom -%}
{%- else -%}
  {%- assign denom = goal_cents | default: 1 -%}
  {%- assign num = cart_cents | times: 100 -%}
  {%- assign percent = num | divided_by: denom -%}
{%- endif -%}
{%- if percent < 0 -%}{% assign percent = 0 %}{%- endif -%}
{%- if percent > 100 -%}{% assign percent = 100 %}{%- endif -%}

<div
  class="loyalty-widget loyalty-widget--card"
  id="checkout-goal-{{ block.id }}"
  data-block-id="{{ block.id }}"
  data-component="checkout-goal"
  data-goal-type="{{ mode }}"
  data-rate="{{ rate }}"
  data-goal-points="{{ goal_points | default: '' }}"
  data-goal-subtotal-cents="{{ goal_cents | default: '' }}"
  data-cart-cents="{{ cart_cents }}"
  style="
    --lw-bg: {{ s.bg }};
    --lw-fg: {{ s.fg }};
    --lw-radius: {{ s.corner_radius | default: 14 }}px;
    --lw-align: {{ s.align }};
    --lw-bar-bg: {{ s.bar_bg }};
    --lw-bar-fg: {{ s.bar_fg }};
  "
>
  <div class="loyalty-widget__content">
    <div class="loyalty-widget__row">
      {% if s.show_icon %}
        <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5
            2 6 4 4 6.5 4c1.74 0 3.41.81 4.5 2.09C12.09 4.81 13.76 4 15.5 4
            18 4 20 6 20 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/>
        </svg>
      {% endif %}
      <h3 class="loyalty-widget__heading">{{ s.heading | escape }}</h3>
    </div>

    <p class="loyalty-widget__subtext">
      {% if reached %}
        Goal reached — great job!{% if mode == 'points' %} You’ll earn around <strong>{{ order_points }}</strong> points.{% endif %}
        {% if s.subtext != blank %}<br>{{ s.subtext | newline_to_br }}{% endif %}
      {% else %}
        {% if mode == 'points' %}
          Spend <strong>{{ remaining_cents | money }}</strong> more to reach <strong>{{ goal_label }}</strong> this order.
        {% else %}
          Spend <strong>{{ remaining_cents | money }}</strong> more to reach <strong>{{ goal_label }}</strong>.
        {% endif %}
        {% if s.subtext != blank %}<br>{{ s.subtext | newline_to_br }}{% endif %}
      {% endif %}
    </p>

    {% if s.show_progress %}
      <div class="lw-progress" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ percent }}"
           style="
              margin-top: 10px;
              width: 100%;
              height: 8px;
              border-radius: 999px;
              background: var(--lw-bar-bg);
           ">
        <div class="lw-progress__fill"
             style="
               width: {{ percent }}%;
               height: 100%;
               border-radius: 999px;
               background: var(--lw-bar-fg);
               transition: width .25s ease;
             "></div>
      </div>
      <div class="lw-progress__meta" style="margin-top: 6px; font-size: .9rem; opacity: .8;">
        {{ percent }}% toward {{ goal_label }}
      </div>
    {% endif %}
  </div>
</div>
