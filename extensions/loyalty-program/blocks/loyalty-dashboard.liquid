{%- liquid
  assign dashboard_title = block.settings.dashboard_title | default: 'My Loyalty Dashboard'
  
  # Point rules from settings
  assign points_per_dollar = block.settings.points_per_dollar | default: '100'
  assign signup_bonus_points = block.settings.signup_bonus_points | default: '500'
  assign birthday_bonus_points = block.settings.birthday_bonus_points | default: '200'
  assign review_bonus_points = block.settings.review_bonus_points | default: '50'
  assign referral_bonus_points = block.settings.referral_bonus_points | default: '100'
  assign social_share_points = block.settings.social_share_points | default: '50'
  
  # Tier thresholds
  assign silver_tier_threshold = block.settings.silver_tier_threshold | default: '1000' | plus: 0
  assign gold_tier_threshold = block.settings.gold_tier_threshold | default: '5000' | plus: 0
  
  # FAQ settings
  assign faq_title = block.settings.faq_title | default: 'Frequently Asked Questions'
  assign faq_content = block.settings.faq_content | default: ''
  
  # Create point rules array for JavaScript
  capture point_rules_json
    echo '['
    echo '{"points":"' | append: points_per_dollar | append: '","description":"For every $1 spent"}'
    echo ',{"points":"' | append: signup_bonus_points | append: '","description":"Account signup bonus"}'
    echo ',{"points":"' | append: birthday_bonus_points | append: '","description":"Birthday bonus"}'
    echo ',{"points":"' | append: review_bonus_points | append: '","description":"Leaving a product review"}'
    echo ',{"points":"' | append: referral_bonus_points | append: '","description":"Referring a friend"}'
    echo ',{"points":"' | append: social_share_points | append: '","description":"Sharing on social media"}'
    echo ']'
  endcapture
-%}

<script>
  window.pointRules = {{ point_rules_json | strip_newlines }};
</script>

{% comment %} Add this near the top of the file, after the initial liquid tags {% endcomment %}
{%- capture point_rules_json -%}
[
{% if shop.metafields.loyalty.point_rules
   and shop.metafields.loyalty.point_rules.value
   and shop.metafields.loyalty.point_rules.value.size > 0 %}
  
  {% for rule in shop.metafields.loyalty.point_rules.value %}
    {
      "points": {{ rule.points | json }},
      "description": {{ rule.description | json }},
      "isActive": {{ rule.isActive | json }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}

{% else %}
  {
    "points": {{ points_per_dollar | json }},
    "description": "For every $1 spent",
    "isActive": true
  }
{% endif %}
]
{%- endcapture -%}




