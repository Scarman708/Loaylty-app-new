  <script>
    // Function to load and display available rewards
    async function loadRewards(customerId) {
      try {
        const response = await fetch(`/apps/loyalty/api/loyalty/rewards?customerId=${customerId}&shop=${window.Shopify.shop}`);
        const data = await response.json();
        
        if (!data.success) {
          console.error('Failed to load rewards:', data.error);
          return [];
        }
        
        return data.rewards || [];
      } catch (error) {
        console.error('Error loading rewards:', error);
        return [];
      }
    }

    // Function to handle point redemption
    async function redeemPoints(ruleId, points) {
      try {
        const response = await fetch('/apps/loyalty/api/loyalty/redeem', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            customerId: window.loyaltyData.customerId,
            ruleId: ruleId,
            points: points,
            shop: window.Shopify.shop
          })
        });
        
        const result = await response.json();
        
        if (result.error) {
          throw new Error(result.error);
        }
        
        return result;
      } catch (error) {
        console.error('Redemption failed:', error);
        throw error;
      }
    }

    // Function to update the rewards UI
    function updateRewardsUI(rewards) {
      const rewardsContainer = document.querySelector('.rewards-container');
      if (!rewardsContainer) return;
      
      if (rewards.length === 0) {
        rewardsContainer.innerHTML = `
          <div class="no-rewards">
            <p>No rewards available at the moment. Check back later!</p>
          </div>
        `;
        return;
      }
      
      rewardsContainer.innerHTML = `
        <div class="rewards-grid">
          ${rewards.map(reward => `
            <div class="reward-card ${reward.canRedeem ? 'reward-available' : 'reward-locked'}">
              <div class="reward-header">
                <h3 class="reward-title">${reward.title}</h3>
                <div class="reward-points">${reward.minPoints} pts</div>
              </div>
              <div class="reward-description">${reward.description || ''}</div>
              ${reward.nextStepPoints ? 
                `<div class="reward-next-tier">
                  Or earn ${reward.nextStepPoints - window.loyaltyData.currentPoints} more points
                </div>` : ''
              }
              <button 
                class="button reward-button ${!reward.canRedeem ? 'button--disabled' : ''}"
                data-rule-id="${reward.id}"
                data-points="${reward.minPoints}"
                ${!reward.canRedeem ? 'disabled' : ''}
              >
                ${reward.canRedeem ? 'Redeem Now' : 'Not Enough Points'}
              </button>
            </div>
          `).join('')}
        </div>
      `;
      
      // Add event listeners to redeem buttons
      document.querySelectorAll('.reward-button:not(.button--disabled)').forEach(button => {
        button.addEventListener('click', async () => {
          const ruleId = button.dataset.ruleId;
          const points = parseInt(button.dataset.points, 10);
          
          // Show loading state
          const originalText = button.textContent;
          button.disabled = true;
          button.textContent = 'Processing...';
          
          try {
            const result = await redeemPoints(ruleId, points);
            
            // Update UI with success message
            const successMessage = document.createElement('div');
            successMessage.className = 'alert alert--success';
            successMessage.textContent = 'Success! Your reward has been redeemed.';
            rewardsContainer.prepend(successMessage);
            
            // Reload dashboard to update points
            setTimeout(() => {
              window.location.reload();
            }, 2000);
            
          } catch (error) {
            // Show error message
            const errorMessage = document.createElement('div');
            errorMessage.className = 'alert alert--error';
            errorMessage.textContent = error.message || 'Failed to redeem points. Please try again.';
            rewardsContainer.prepend(errorMessage);
            
            // Reset button state
            button.disabled = false;
            button.textContent = originalText;
            
            // Remove error message after 5 seconds
            setTimeout(() => {
              errorMessage.remove();
            }, 5000);
          }
        });
      });
    }

    document.addEventListener('DOMContentLoaded', async function() {
      const contentDiv = document.getElementById('loyalty-dashboard-content');
      const pointRules = Array.isArray(window.pointRules)
      ? window.pointRules
      : [];

    const baseRule = pointRules.find(r => r.isActive) || { points: 0 }; 
      try {
        // Fetch customer loyalty data
        const response = await fetch("/apps/loyalty-program/api/loyalty/dashboard?customerId={{ customer.id }}", {
          method: "GET",
          headers: { "Content-Type": "application/json" }
        });

        const data = await response.json();

        if (!response.ok) {
          throw new Error(data.error || 'Failed to load dashboard');
        }

        if (!data.enrolled) {
          contentDiv.innerHTML = `
            <div class="loyalty-error">
              <div class="loyalty-error__title">Not Enrolled</div>
              <p>You're not enrolled in our loyalty program yet. Join now to start earning points!</p>
            </div>
          `;
          return;
        }

        // Get point rules from Liquid to JavaScript
      
        
        // Get tier thresholds from Liquid to JavaScript
        const silverTierThreshold = {{ silver_tier_threshold }};
        const goldTierThreshold = {{ gold_tier_threshold }};
const baseRule = pointRules.find(r => r.isActive) || { points: 0 };

        const tiers = [
          {
            name: 'Bronze',
            minPoints: 0,
            perks: [
              `Earn ${baseRule.points} points per $1 spent`,
              'Exclusive member-only offers',
              'Birthday reward',
              'Early access to sales'
            ],
            nextTier: 'Silver',
            pointsNeeded: silverTierThreshold
          },
          {
            name: 'Silver',
            minPoints: silverTierThreshold,
            perks: [
              'All Bronze benefits',
              `Earn ${Math.round(parseInt(baseRule.points) * 1.25)} points per $1 spent`,
              'Free shipping on all orders',
              '5% discount on all purchases',
              'Dedicated support'
            ],
            nextTier: 'Gold',
            pointsNeeded: goldTierThreshold
          },
          {
            name: 'Gold',
            minPoints: goldTierThreshold,
            perks: [
              'All Silver benefits',
              `Earn ${Math.round(parseInt(baseRule.points) * 1.5)} points per $1 spent`,
              '10% discount on all purchases',
              'Free express shipping',
              'Exclusive products access',
              'Surprise gifts'
            ],
            nextTier: null
          }
        ];

        // Find current tier and next tier
        const currentTier = data.tier || 'Bronze';
        const currentTierData = tiers.find(t => t.name === currentTier) || tiers[0];
        const nextTier = tiers.find(t => t.name === currentTierData.nextTier);
        const currentPoints = data.points || 0;

        // Render dashboard
        contentDiv.innerHTML = `
          <!-- Tier Upgrade Announcement -->
          <div class="tier-upgrade-announcement hidden" id="tierUpgradeAnnouncement">
            <div class="tier-upgrade-content">
              <span class="tier-upgrade-icon">🎉</span>
              <div class="tier-upgrade-message" id="tierUpgradeMessage"></div>
            </div>
            <div>
              <button class="tier-upgrade-cta" id="tierUpgradeCta">Upgrade Now</button>
              <button class="tier-upgrade-close" id="tierUpgradeClose">&times;</button>
            </div>
          </div>
          
          <div class="loyalty-dashboard__grid">
            <div class="loyalty-card">
              <div class="loyalty-card__title">Current Tier</div>
              <div class="loyalty-card__value tier-${currentTier.name.toLowerCase()}">${currentTier.name}</div>
              <div class="loyalty-card__subtext">${currentTier.percentage}% to next tier</div>
            </div>
            
            <div class="loyalty-card">
              <div class="loyalty-card__title">Your Points</div>
              <div class="loyalty-card__value">${currentPoints.toLocaleString()}</div>
              <div class="loyalty-card__subtext">${rewards.length} rewards available</div>
              
              <div class="loyalty-card__actions" style="display: flex; flex-direction: column; gap: 0.5rem; margin-top: 1rem;">
                <button class="button button--primary" id="redeem-points-btn" style="width: 100%;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
                    <path d="M20 12v10H4V12"></path>
                    <path d="M22 7H2l10 10L22 7z"></path>
                  </svg>
                  Redeem Point
                </button>
                <button class="button button--secondary" id="view-rewards-btn" style="width: 100%;">
                  <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 6px; vertical-align: middle;">
                    <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                    <circle cx="12" cy="12" r="3"></circle>
                  </svg>
                  View All Rewards
                </button>
              </div>
              
              ${nextTier ? `
                <div style="margin-top: 1rem; padding-top: 0.75rem; border-top: 1px dashed #e5e7eb; font-size: 0.8rem; color: #6b7280;">
                  <div style="display: flex; justify-content: space-between; margin-bottom: 4px;">
                    <span>Next tier (${nextTier.name}):</span>
                    <span>${nextTier.minPoints - currentPoints} more points</span>
                  </div>
                  <div class="progress-bar" style="height: 6px; background: #e5e7eb; border-radius: 3px; overflow: hidden; margin-top: 4px;">
                    <div style="height: 100%; background: #4f46e5; width: ${Math.min(100, Math.max(0, (currentPoints / nextTier.minPoints) * 100))}%; transition: width 0.3s ease;"></div>
                  </div>
                </div>
              ` : ''}
            </div>
            
            <div class="loyalty-card loyalty-card--secondary">
              <div class="loyalty-card__title">Member Since</div>
              <div class="loyalty-card__value">${new Date(data.joinedDate).toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}</div>
              <div class="loyalty-card__subtitle">Loyal customer</div>
            </div>
            
            <div class="loyalty-card loyalty-card--tertiary">
              <div class="loyalty-card__title">Membership Tier</div>
              <div class="loyalty-card__value">${currentTier}</div>
              <div class="loyalty-card__subtitle">${nextTier ? `Earn ${nextTier.pointsNeeded - currentPoints} more points for ${nextTier.name} tier` : 'You\'ve reached the highest tier!'}</div>
            </div>
          </div>
          
          <!-- Rewards Section (initially hidden) -->
          <div id="rewards-section" class="rewards-section" style="display: none;">
            <h2 class="rewards-section__title">Available Rewards</h2>
            <div class="rewards-container">
              <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Loading rewards...</p>
              </div>
            </div>
          </div>
          
          <div class="loyalty-history">
            <h2 class="loyalty-history__title">Recent Activity</h2>
            ${data.transactions && data.transactions.length > 0 ? `
              <table class="loyalty-history__table">
                <thead>
                  <tr>
                    <th>Date</th>
                    <th>Description</th>
                    <th style="text-align: right;">Points</th>
                  </tr>
                </thead>
                <tbody>
                  ${data.transactions.map(t => `
                    <tr>
                      <td>${new Date(t.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</td>
                      <td>${t.description}</td>
                      <td style="text-align: right;" class="${t.points > 0 ? 'points-positive' : 'points-negative'}">
                        ${t.points > 0 ? '+' : ''}${t.points}
                      </td>
                    </tr>
                  `).join('')}
                </tbody>
              </table>
            ` : `
              <div class="loyalty-history__empty">
                <p>No activity yet. Start shopping to earn points!</p>
              </div>
            `}
          </div>
          
          <div class="loyalty-section">
            <div class="loyalty-section__header">
              <h2 class="section-title">How to Earn Points</h2>
              <p>Discover all the ways you can earn points and unlock amazing rewards.</p>
            </div>
            
            <div class="point-rules-container">
              <div class="point-rules-grid">
                ${pointRules.map(rule => `
                  <div class="point-rule-card">
                    <div class="point-rule-card__points">+${rule.points}</div>
                    <div class="point-rule-card__divider"></div>
                    <div class="point-rule-card__description">${rule.description}</div>
                  </div>
                `).join('')}
              </div>
            </div>
            
            <div class="faq-section">
              <button type="button" class="collapsible">
                <span>Frequently Asked Questions</span>
                
              </button>
              <div class="collapsible-content">
                <div class="faq-content">
                  {{ faq_content }}
                </div>
              </div>
            </div>
          </div>
          
          <!-- Rewards Section -->
          <div class="rewards-section" id="rewards-section" style="display: none; margin-top: 2rem; padding-top: 2rem; border-top: 1px solid #e5e7eb;">
            <h2 class="section-title">Available Rewards</h2>
            <p class="section-subtitle">Redeem your points for exclusive rewards</p>
            
            <div class="rewards-container">
              <div class="loading-spinner">
                <div class="spinner"></div>
                <p>Loading rewards...</p>
              </div>
            </div>
          </div>
          
          <div class="tier-benefits">
            <h2 class="section-title">Membership Tiers</h2>
            ${tiers.map(tier => `
              <div class="tier-card">
                <div class="tier-header">
                  <div class="tier-name">${tier.name} Tier</div>
                  <div class="tier-status ${tier.name === currentTier ? 'current' : ''}">
                    ${tier.name === currentTier ? 'Current Tier' : (tier.minPoints > currentPoints ? `${tier.minPoints.toLocaleString()} points needed` : '')}
                  </div>
                </div>
                
                <div class="tier-perks">
                  ${tier.perks.map(perk => `
                    <div class="perk-item">
                      <span class="perk-icon">✓</span>
                      <span>${perk}</span>
                    </div>
                  `).join('')}
                </div>
                
                ${tier.name === currentTier && tier.nextTier ? `
                  <button class="upgrade-btn" disabled>
                    Your Current Tier
                  </button>
                ` : tier.minPoints <= currentPoints ? `
                  <button class="upgrade-btn upgrade-available" data-tier="${tier.name}">
                    Upgrade to ${tier.name}
                  </button>
                ` : `
                  <button class="upgrade-btn" disabled>
                    ${tier.minPoints - currentPoints} More Points to Unlock
                  </button>
                `}
              </div>
            `).join('')}
          </div>
        `;

        // Store customer data for later use
        window.loyaltyData = {
          customerId: data.customerId,
          currentPoints: currentPoints,
          lifetimePoints: lifetimePoints,
          currentTier: currentTier,
          tiers: tiers,
          nextTier: nextTier
        };
        
        // Check for available tier upgrades
        function checkForUpgrades() {
          const availableUpgrades = tiers.filter(tier => 
            tier.minPoints <= currentPoints && tier.name !== currentTier
          );
          
          if (availableUpgrades.length > 0) {
            const nextAvailableTier = availableUpgrades.reduce((highestTier, tier) => {
              return tier.minPoints > highestTier.minPoints ? tier : highestTier;
            }, availableUpgrades[0]);
            
            const announcement = document.getElementById('tierUpgradeAnnouncement');
            const message = document.getElementById('tierUpgradeMessage');
            const cta = document.getElementById('tierUpgradeCta');
            
            if (announcement && message && cta) {
              message.textContent = `You've unlocked the ${nextAvailableTier.name} tier!`;
              cta.textContent = 'Upgrade Now';
              cta.onclick = () => scrollToTier(nextAvailableTier.name);
              announcement.classList.remove('hidden');
              
              // Store in session storage to prevent showing again
              if (sessionStorage) {
                const shownAnnouncement = sessionStorage.getItem(`tierAnnouncement_${nextAvailableTier.name}`);
                if (shownAnnouncement) {
                  announcement.classList.add('hidden');
                } else {
                  sessionStorage.setItem(`tierAnnouncement_${nextAvailableTier.name}`, 'true');
                }
              }
            }
          }
        }
        
        // Function to scroll to a specific tier card
        function scrollToTier(tierName) {
          const tierCards = document.querySelectorAll('.tier-card');
          tierCards.forEach(card => {
            if (card.querySelector('.tier-name').textContent.includes(tierName)) {
              card.scrollIntoView({ behavior: 'smooth', block: 'center' });
              card.style.animation = 'highlight 2s ease-in-out';
              setTimeout(() => {
                card.style.animation = '';
              }, 2000);
            }
          });
        }
        
        // Handle upgrade button clicks
        document.querySelectorAll('.upgrade-available').forEach(button => {
          button.addEventListener('click', async function() {
            const tierName = this.dataset.tier;
            const tier = tiers.find(t => t.name === tierName);
            
            if (tier && confirm(`Are you sure you want to upgrade to ${tierName} tier?`)) {
              try {
                // Show loading state
                const originalText = this.textContent;
                this.disabled = true;
                this.innerHTML = '<span class="spinner"></span> Upgrading...';
                
                // Call API to update tier
                const response = await fetch('/apps/loyalty/api/loyalty/upgrade-tier', {
                  method: 'POST',
                  headers: {
                    'Content-Type': 'application/json',
                  },
                  body: JSON.stringify({
                    customerId: window.loyaltyData.customerId,
                    tierName: tierName,
                    shop: window.Shopify.shop
                  })
                });
                
                const result = await response.json();
                
                if (response.ok && result.success) {
                  // Show success message and reload
                  alert(`Congratulations! You've been upgraded to ${tierName} tier.`);
                  window.location.reload();
                } else {
                  throw new Error(result.error || 'Failed to upgrade tier');
                }
              } catch (error) {
                console.error('Upgrade error:', error);
                alert(error.message || 'Failed to upgrade tier. Please try again.');
                this.disabled = false;
                this.textContent = originalText;
              }
            }
          });
        });
        
        // Close announcement
        const closeBtn = document.getElementById('tierUpgradeClose');
        if (closeBtn) {
          closeBtn.addEventListener('click', function() {
            const announcement = document.getElementById('tierUpgradeAnnouncement');
            if (announcement) {
              announcement.classList.add('hidden');
            }
          });
        }
        
        // Check for upgrades when page loads
        checkForUpgrades();
        
        // Handle redeem points button click
        const redeemPointsBtn = document.getElementById('redeem-points-btn');
        if (redeemPointsBtn) {
          redeemPointsBtn.addEventListener('click', () => {
            const rewardsSection = document.getElementById('rewards-section');
            if (rewardsSection) {
              rewardsSection.style.display = 'block';
              rewardsSection.scrollIntoView({ behavior: 'smooth' });
              
              // If rewards aren't loaded yet, load them
              if (!rewardsLoaded) {
                loadRewards(customerId);
              }
            }
          });
        }

        // Add highlight animation
        const style = document.createElement('style');
        style.textContent = `
          @keyframes highlight {
            0% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0.7); }
            70% { box-shadow: 0 0 0 10px rgba(79, 70, 229, 0); }
            100% { box-shadow: 0 0 0 0 rgba(79, 70, 229, 0); }
          }
          .tier-card {
            transition: all 0.3s ease;
          }
          .upgrade-available {
            background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
            color: white;
            border: none;
            cursor: pointer;
          }
          .upgrade-available:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
          }
        `;
        document.head.appendChild(style);
        
        // Load and display rewards
        const viewRewardsBtn = document.getElementById('view-rewards-btn');
        const rewardsSection = document.getElementById('rewards-section');
        let rewardsLoaded = false;
        
        viewRewardsBtn.addEventListener('click', async () => {
          rewardsSection.style.display = 'block';
          viewRewardsBtn.textContent = 'Loading Rewards...';
          viewRewardsBtn.disabled = true;
          
          if (!rewardsLoaded) {
            try {
              const rewards = await loadRewards(data.customerId);
              updateRewardsUI(rewards);
              rewardsLoaded = true;
            } catch (error) {
              console.error('Failed to load rewards:', error);
              const container = document.querySelector('.rewards-container');
              if (container) {
                container.innerHTML = `
                  <div class="alert alert--error">
                    Failed to load rewards. Please try again later.
                  </div>
                `;
              }
            } finally {
              viewRewardsBtn.textContent = 'Hide Rewards';
              viewRewardsBtn.disabled = false;
            }
          } else {
            rewardsSection.style.display = rewardsSection.style.display === 'none' ? 'block' : 'none';
            viewRewardsBtn.textContent = rewardsSection.style.display === 'none' ? 'View Rewards' : 'Hide Rewards';
          }
        });
        
        // Close rewards section when clicking outside
        document.addEventListener('click', (e) => {
          if (rewardsSection && !rewardsSection.contains(e.target) && 
              e.target !== viewRewardsBtn && !viewRewardsBtn.contains(e.target)) {
            rewardsSection.style.display = 'none';
            viewRewardsBtn.textContent = 'View Rewards';
          }
        });

      } catch (err) {
        console.error('Dashboard error:', err);
        contentDiv.innerHTML = `
          <div class="loyalty-error">
            <div class="loyalty-error__title">Error Loading Dashboard</div>
            <p>${err.message}</p>
            <p>Please try refreshing the page or contact support if the problem persists.</p>
          </div>
        `;
      }
      });
      
      // Add collapsible functionality
      document.addEventListener('click', function(e) {
        if (e.target.classList.contains('collapsible') || e.target.closest('.collapsible')) {
          const collapsible = e.target.classList.contains('collapsible') ? e.target : e.target.closest('.collapsible');
          collapsible.classList.toggle('active');
          const content = collapsible.nextElementSibling;
          if (content.style.maxHeight) {
            content.style.maxHeight = null;
          } else {
            content.style.maxHeight = content.scrollHeight + 'px';
          }
        }
      });
  </script>
{% endif %}
  {% schema %}
  {
    "name": "Loyalty Dashboard",
    "target": "section",
    "settings": [
      {
        "type": "text",
        "id": "dashboard_title",
        "label": "Dashboard Title",
        "default": "My Loyalty Dashboard"
      },
      {
        "type": "header",
        "content": "Point Rules"
      },
      {
        "type": "text",
        "id": "points_per_dollar",
        "label": "Points per $1 spent",
        "default": "100"
      },
      {
        "type": "text",
        "id": "signup_bonus_points",
        "label": "Signup Bonus Points",
        "default": "500"
      },
      {
        "type": "text",
        "id": "birthday_bonus_points",
        "label": "Birthday Bonus Points",
        "default": "200"
      },
      {
        "type": "text",
        "id": "review_bonus_points",
        "label": "Review Bonus Points",
        "default": "50"
      },
      {
        "type": "text",
        "id": "referral_bonus_points",
        "label": "Referral Bonus Points",
        "default": "100"
      },
      {
        "type": "text",
        "id": "social_share_points",
        "label": "Social Share Points",
        "default": "50"
      },
      {
        "type": "header",
        "content": "Tier Settings"
      },
      {
        "type": "text",
        "id": "silver_tier_threshold",
        "label": "Silver Tier Points Threshold",
        "default": "1000"
      },
      {
        "type": "text",
        "id": "gold_tier_threshold",
        "label": "Gold Tier Points Threshold",
        "default": "5000"
      },
      {
        "type": "header",
        "content": "FAQ Settings"
      },
      {
        "type": "text",
        "id": "faq_title",
        "label": "FAQ Section Title",
        "default": "Frequently Asked Questions"
      },
      {
        "type": "richtext",
        "id": "faq_content",
        "label": "FAQ Content",
        "default": "<p><strong>How do I earn points?</strong><br>You can earn points by making purchases, referring friends, leaving reviews, and more.</p><p><strong>How do I redeem my points?</strong><br>Points can be redeemed at checkout for discounts and special offers.</p><p><strong>Do points expire?</strong><br>Points typically expire after 12 months of inactivity.</p>"
      }
    ]
  }
  {% endschema %}
