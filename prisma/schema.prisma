generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id              Int                @id @default(autoincrement())
  shopDomain      String             @unique
  shopId          BigInt?
  accessToken     String?
  currencyCode    String?
  installedAt     DateTime?          @default(now())
  uninstalledAt   DateTime?
  status          ProgramStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  snapshots       BalanceSnapshot[]
  customers       Customer[]
  earningRules    EarningRule[]
  expiryPolicy    ExpiryPolicy?
  goals           GoalConfig?
  loyaltyPoints   LoyaltyPoint[]
  ledgers         PointLedger[]
  pointRules      PointRule[]
  program         ProgramSettings?
  redemptionRules RedemptionRule[]
  redemptions     RewardRedemption[]
  tiers           Tier[]
  webhooks        WebhookLog[]

  @@index([status])
}

model ProgramSettings {
  id                     Int           @id @default(autoincrement())
  shopId                 Int           @unique
  pointsPerCurrency      Int           @default(1)
  rounding               RoundingMode  @default(nearest)
  excludeDiscounts       Boolean       @default(true)
  earnOnShipping         Boolean       @default(false)
  earnOnTaxes            Boolean       @default(false)
  holdEvent              EarnHoldEvent @default(PAID)
  minSubtotalCents       Int           @default(1000)
  maxPointsPerOrder      Int?
  dailyEarnCap           Int?
  monthlyEarnCap         Int?
  referralsEnabled       Boolean       @default(false)
  referrerBonus          Int?
  refereeBonus           Int?
  status                 ProgramStatus @default(ACTIVE)
  reviewBasePoints       Int           @default(50)
  maxReviewsPerMonth     Int           @default(2)
  bronzeSignupBonus      Int           @default(100)
  silverUnlockBonus      Int           @default(300)
  goldUnlockBonus        Int           @default(500)
  birthdayPoints         Int           @default(200)
  birthdayExpiryDays     Int           @default(30)
  birthdayMinDays        Int           @default(7)
  bronzeSpendMultiplier  Float         @default(1.0)
  bronzeReviewMultiplier Float         @default(1.0)
  silverSpendMultiplier  Float         @default(1.25)
  silverReviewMultiplier Float         @default(1.5)
  goldSpendMultiplier    Float         @default(1.5)
  goldReviewMultiplier   Float         @default(2.0)
  bronzeThreshold        Int           @default(0)
  silverThreshold        Int           @default(2000)
  goldThreshold          Int           @default(5000)
  redemptionRate         Int           @default(100)
  redemptionValue        Int           @default(5)
  minRedemption          Int           @default(100)
  preventStacking        Boolean       @default(false)
  pointsExpiryMonths     Int           @default(12)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  shop                   Shop          @relation(fields: [shopId], references: [id])
}

model PointRule {
  id          Int           @id @default(autoincrement())
  shopId      Int
  type        PointRuleType
  points      Int
  description String
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  shop        Shop          @relation(fields: [shopId], references: [id])

  @@unique([shopId, type])
}

model ExpiryPolicy {
  id             Int        @id @default(autoincrement())
  shopId         Int        @unique
  type           ExpiryType @default(NONE)
  rollingDays    Int?
  fixedDate      DateTime?
  issueGraceDays Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  shop           Shop       @relation(fields: [shopId], references: [id])
}

model EarningRule {
  id                Int             @id @default(autoincrement())
  shopId            Int
  type              EarningRuleType
  title             String
  description       String?
  multiplier        Float?
  fixedPoints       Int?
  applyOncePerOrder Boolean         @default(false)
  capPerOrder       Int?
  capPerCustomer    Int?
  capWindowUnit     PeriodUnit?
  capWindowCount    Int?
  conditions        Json?
  enabled           Boolean         @default(true)
  activeFrom        DateTime?
  activeUntil       DateTime?
  priority          Int             @default(100)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  shop              Shop            @relation(fields: [shopId], references: [id])

  @@index([shopId, type, enabled, priority])
}

model RedemptionRule {
  id               Int                @id @default(autoincrement())
  shopId           Int
  type             RedemptionRuleType
  title            String
  description      String?
  minPoints        Int                @default(0)
  stepPoints       Int?
  discountCents    Int?
  discountPercent  Float?
  maxDiscountCents Int?
  requiresCode     Boolean            @default(false)
  conditions       Json?
  enabled          Boolean            @default(true)
  activeFrom       DateTime?
  activeUntil      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  shop             Shop               @relation(fields: [shopId], references: [id])
  RewardRedemption RewardRedemption[]

  @@index([shopId, type, enabled])
}

model Tier {
  id                 Int            @id @default(autoincrement())
  shopId             Int
  name               String
  minPoints          Int            @default(0)
  color              String?
  icon               String?
  windowType         TierWindowType @default(LIFETIME)
  windowDays         Int?
  downgradeGraceDays Int?
  benefits           Json?
  sortOrder          Int            @default(100)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  multiplier         Float?
  Customer           Customer[]
  shop               Shop           @relation(fields: [shopId], references: [id])

  @@index([shopId, sortOrder])
}

model Customer {
  id                Int                @id @default(autoincrement())
  shopId            Int
  shopCustomerId    BigInt
  email             String?
  acceptsMarketing  Boolean?           @default(false)
  pointBalance      Int                @default(0)
  lifetimePoints    Int                @default(0)
  currentTierId     Int?
  referralCode      String?            @unique
  referredByCode    String?            @unique
  birthday          DateTime?
  lastEarnedAt      DateTime?
  lastRedeemedAt    DateTime?
  lastActivityAt    DateTime?
  isActive          Boolean            @default(true)
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  snapshots         BalanceSnapshot[]
  shop              Shop               @relation(fields: [shopId], references: [id])
  currentTier       Tier?              @relation(fields: [currentTierId], references: [id])
  referredBy        Customer?          @relation("CustomerReferrals", fields: [referredByCode], references: [referralCode])
  referredCustomers Customer?          @relation("CustomerReferrals")
  pointTransactions LoyaltyPoint[]
  ledgers           PointLedger[]
  redemptions       RewardRedemption[]

  @@unique([shopId, shopCustomerId])
  @@index([shopId, email])
  @@index([referralCode])
  @@index([currentTierId])
  @@index([pointBalance])
  @@index([isActive])
}

model LoyaltyPoint {
  id          Int       @id @default(autoincrement())
  customerId  Int
  shopId      Int
  points      Int
  type        String
  description String
  referenceId String?
  expiresAt   DateTime?
  status      String    @default("active")
  metadata    Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  shop        Shop      @relation(fields: [shopId], references: [id])
  customer    Customer  @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([shopId])
  @@index([type])
  @@index([status])
  @@index([expiresAt])
  @@index([referenceId])
}

model RewardRedemption {
  id          Int             @id @default(autoincrement())
  shopId      Int
  customerId  Int
  pointsUsed  Int
  rewardType  String
  rewardValue Json
  status      String          @default("redeemed")
  referenceId String?
  metadata    Json?
  processedAt DateTime?
  expiresAt   DateTime?
  ruleId      Int?
  code        String?         @unique
  valueCents  Int?
  orderId     BigInt?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  rule        RedemptionRule? @relation(fields: [ruleId], references: [id])
  shop        Shop            @relation(fields: [shopId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@index([rewardType])
  @@index([referenceId])
  @@index([shopId, customerId, status])
  @@index([shopId, orderId])
}

model PointLedger {
  id          Int          @id @default(autoincrement())
  shopId      Int
  customerId  Int
  delta       Int
  reason      LedgerReason
  source      LedgerSource
  note        String?
  orderId     BigInt?
  orderName   String?
  status      LedgerStatus @default(PENDING)
  availableAt DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  customer    Customer     @relation(fields: [customerId], references: [id])
  shop        Shop         @relation(fields: [shopId], references: [id])

  @@index([shopId, customerId, status])
  @@index([shopId, orderId])
}

model BalanceSnapshot {
  id             Int      @id @default(autoincrement())
  shopId         Int
  customerId     Int
  balance        Int
  lifetimePoints Int
  tierId         Int?
  takenAt        DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id])
  shop           Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, customerId, takenAt])
}

model GoalConfig {
  id            Int      @id @default(autoincrement())
  shopId        Int      @unique
  type          GoalType @default(SUBTOTAL)
  subtotalCents Int?
  pointsGoal    Int?
  barEnabled    Boolean  @default(true)
  barColorFg    String?
  barColorBg    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id])
}

model WebhookLog {
  id         Int      @id @default(autoincrement())
  shopId     Int
  topic      String
  success    Boolean  @default(true)
  statusCode Int?
  payload    Json?
  error      String?
  createdAt  DateTime @default(now())
  shop       Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, topic, createdAt])
}

enum PointRuleType {
  PURCHASE
  SIGNUP
  BIRTHDAY
  REVIEW
  REFERRAL
  SOCIAL_SHARE
}

enum ProgramStatus {
  ACTIVE
  PAUSED
}

enum RoundingMode {
  down
  nearest
  up
}

enum EarnHoldEvent {
  NONE
  PAID
  FULFILLED
}

enum ExpiryType {
  NONE
  ROLLING
  FIXED_DATE
}

enum EarningRuleType {
  ORDER
  PRODUCT_TAG
  COLLECTION
  SIGNUP
  BIRTHDAY
  REFERRAL
  REVIEW
  CUSTOM_EVENT
}

enum RedemptionRuleType {
  CART_DISCOUNT
  PRODUCT_DISCOUNT
  FREE_SHIPPING
  FIXED_VOUCHER
  CUSTOM_AWARD
}

enum LedgerReason {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVOKE
  REFERRAL_BONUS
  REFUND_REVERSAL
  ORDER_CANCELLED
  TIER_UPGRADE
}

enum LedgerSource {
  ORDER
  ADMIN
  REFERRAL
  REVIEW
  BIRTHDAY
  SIGNUP
  MANUAL
  API
  SYSTEM
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  EXPIRED
  REVOKED
}

enum TierWindowType {
  LIFETIME
  ROLLING_WINDOW_DAYS
}

enum PeriodUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum GoalType {
  SUBTOTAL
  POINTS
}
