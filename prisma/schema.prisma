generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Shop {
  id              Int                @id @default(autoincrement())
  shopDomain      String             @unique
  shopId          BigInt?
  accessToken     String?
  currencyCode    String?
  installedAt     DateTime?          @default(now())
  uninstalledAt   DateTime?
  status          ProgramStatus      @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  snapshots       BalanceSnapshot[]
  customers       Customer[]
  earningRules    EarningRule[]
  expiryPolicy    ExpiryPolicy?
  goals           GoalConfig?
  ledgers         PointLedger[]
  program         ProgramSettings?
  redemptionRules RedemptionRule[]
  redemptions     RewardRedemption[]
  tiers           Tier[]
  webhooks        WebhookLog[]

  @@index([status])
}

model ProgramSettings {
  id                Int           @id @default(autoincrement())
  shopId            Int           @unique
  pointsPerCurrency Int           @default(10)
  rounding          RoundingMode  @default(nearest)
  excludeDiscounts  Boolean       @default(false)
  earnOnShipping    Boolean       @default(false)
  earnOnTaxes       Boolean       @default(false)
  holdEvent         EarnHoldEvent @default(PAID)
  minSubtotalCents  Int           @default(0)
  maxPointsPerOrder Int?
  dailyEarnCap      Int?
  monthlyEarnCap    Int?
  referralsEnabled  Boolean       @default(false)
  referrerBonus     Int?
  refereeBonus      Int?
  status            ProgramStatus @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  shop              Shop          @relation(fields: [shopId], references: [id])
}

model ExpiryPolicy {
  id             Int        @id @default(autoincrement())
  shopId         Int        @unique
  type           ExpiryType @default(NONE)
  rollingDays    Int?
  fixedDate      DateTime?
  issueGraceDays Int?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  shop           Shop       @relation(fields: [shopId], references: [id])
}

model EarningRule {
  id                Int             @id @default(autoincrement())
  shopId            Int
  type              EarningRuleType
  title             String
  description       String?
  multiplier        Float?
  fixedPoints       Int?
  applyOncePerOrder Boolean         @default(false)
  capPerOrder       Int?
  capPerCustomer    Int?
  capWindowUnit     PeriodUnit?
  capWindowCount    Int?
  conditions        Json?
  enabled           Boolean         @default(true)
  activeFrom        DateTime?
  activeUntil       DateTime?
  priority          Int             @default(100)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  shop              Shop            @relation(fields: [shopId], references: [id])

  @@index([shopId, type, enabled, priority])
}

model RedemptionRule {
  id               Int                @id @default(autoincrement())
  shopId           Int
  type             RedemptionRuleType
  title            String
  description      String?
  minPoints        Int                @default(0)
  stepPoints       Int?
  discountCents    Int?
  discountPercent  Float?
  maxDiscountCents Int?
  requiresCode     Boolean            @default(false)
  conditions       Json?
  enabled          Boolean            @default(true)
  activeFrom       DateTime?
  activeUntil      DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  shop             Shop               @relation(fields: [shopId], references: [id])
  RewardRedemption RewardRedemption[]

  @@index([shopId, type, enabled])
}

model Tier {
  id                 Int            @id @default(autoincrement())
  shopId             Int
  name               String
  minPoints          Int            @default(0)
  color              String?
  icon               String?
  windowType         TierWindowType @default(LIFETIME)
  windowDays         Int?
  downgradeGraceDays Int?
  benefits           Json?
  sortOrder          Int            @default(100)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  Customer           Customer[]
  shop               Shop           @relation(fields: [shopId], references: [id])

  @@index([shopId, sortOrder])
}



model Customer {
  id               Int                @id @default(autoincrement())
  shopId           Int
  shopCustomerId   BigInt
  email            String?
  acceptsMarketing Boolean?
  pointBalance     Int                @default(0)
  lifetimePoints   Int                @default(0)
  currentTierId    Int?
  referralCode     String?            @unique
  referredByCode   String?    @unique
  referredBy       Customer?  @relation("CustomerReferrals", fields: [referredByCode], references: [referredByCode])
  referredCustomers Customer[] @relation("CustomerReferrals")
  birthday         DateTime?
  lastEarnedAt     DateTime?
  lastRedeemedAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  snapshots        BalanceSnapshot[]
  currentTier      Tier?              @relation(fields: [currentTierId], references: [id])
  shop             Shop               @relation(fields: [shopId], references: [id])
  ledgers          PointLedger[]
  redemptions      RewardRedemption[]

  @@unique([shopId, shopCustomerId])
  @@index([shopId, email])
}

model PointLedger {
  id          Int          @id @default(autoincrement())
  shopId      Int
  customerId  Int
  delta       Int
  reason      LedgerReason
  source      LedgerSource
  note        String?
  orderId     BigInt?
  orderName   String?
  status      LedgerStatus @default(PENDING)
  availableAt DateTime?
  expiresAt   DateTime?
  metadata    Json?
  createdAt   DateTime     @default(now())
  customer    Customer     @relation(fields: [customerId], references: [id])
  shop        Shop         @relation(fields: [shopId], references: [id])

  @@index([shopId, customerId, status])
  @@index([shopId, orderId])
}

model RewardRedemption {
  id          Int            @id @default(autoincrement())
  shopId      Int
  customerId  Int
  ruleId      Int
  pointsSpent Int
  code        String?        @unique
  valueCents  Int?
  status      String         @default("ISSUED")
  orderId     BigInt?
  metadata    Json?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  rule        RedemptionRule @relation(fields: [ruleId], references: [id])
  customer    Customer       @relation(fields: [customerId], references: [id])
  shop        Shop           @relation(fields: [shopId], references: [id])

  @@index([shopId, customerId, status])
}

model BalanceSnapshot {
  id             Int      @id @default(autoincrement())
  shopId         Int
  customerId     Int
  balance        Int
  lifetimePoints Int
  tierId         Int?
  takenAt        DateTime @default(now())
  customer       Customer @relation(fields: [customerId], references: [id])
  shop           Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, customerId, takenAt])
}

model GoalConfig {
  id            Int      @id @default(autoincrement())
  shopId        Int      @unique
  type          GoalType @default(SUBTOTAL)
  subtotalCents Int?
  pointsGoal    Int?
  barEnabled    Boolean  @default(true)
  barColorFg    String?
  barColorBg    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  shop          Shop     @relation(fields: [shopId], references: [id])
}

model WebhookLog {
  id         Int      @id @default(autoincrement())
  shopId     Int
  topic      String
  success    Boolean  @default(true)
  statusCode Int?
  payload    Json?
  error      String?
  createdAt  DateTime @default(now())
  shop       Shop     @relation(fields: [shopId], references: [id])

  @@index([shopId, topic, createdAt])
}

enum ProgramStatus {
  ACTIVE
  PAUSED
}

enum RoundingMode {
  down
  nearest
  up
}

enum EarnHoldEvent {
  NONE
  PAID
  FULFILLED
}

enum ExpiryType {
  NONE
  ROLLING
  FIXED_DATE
}

enum EarningRuleType {
  ORDER
  PRODUCT_TAG
  COLLECTION
  SIGNUP
  BIRTHDAY
  REFERRAL
  REVIEW
  CUSTOM_EVENT
}

enum RedemptionRuleType {
  CART_DISCOUNT
  PRODUCT_DISCOUNT
  FREE_SHIPPING
  FIXED_VOUCHER
  CUSTOM_AWARD
}

enum LedgerReason {
  EARN
  REDEEM
  ADJUST
  EXPIRE
  REVOKE
  REFUND_REVERSAL
  ORDER_CANCELLED
}

enum LedgerSource {
  ORDER
  ADMIN
  REFERRAL
  REVIEW
  BIRTHDAY
  SIGNUP
  MANUAL
  API
  SYSTEM
}

enum LedgerStatus {
  PENDING
  AVAILABLE
  EXPIRED
  REVOKED
}

enum TierWindowType {
  LIFETIME
  ROLLING_WINDOW_DAYS
}

enum PeriodUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum GoalType {
  SUBTOTAL
  POINTS
}
